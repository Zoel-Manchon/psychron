<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Level only. The PCM buffer is reduced to two numbers per window in memory
         and discarded; nothing is written to storage and nothing leaves the
         phone that could be turned back into sound. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Position for the track, the altitude that reduces pressure to sea level, and
         the serving cell's band, which the platform only reveals with location. Fine
         and coarse together: Android 12 lets the user pick either in one dialog. No
         background location: a foreground service with a visible notification is
         the only thing that ever reads it. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- The record is only worth keeping if it is continuous. Without a partial
         wake lock the sensors are throttled the moment the screen turns off. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <uses-feature android:name="android.hardware.sensor.barometer" android:required="false" />
    <uses-feature android:name="android.hardware.sensor.light" android:required="false" />
    <uses-feature android:name="android.hardware.sensor.compass" android:required="false" />
    <uses-feature android:name="android.hardware.sensor.gyroscope" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />
    <uses-feature android:name="android.hardware.telephony" android:required="false" />

    <!-- allowBackup off and every extraction rule excluding everything: the app's
         private storage holds a TLS client key, and neither adb backup nor a cloud
         backup nor a device-to-device transfer should ever carry it off. -->
    <application
        android:label="Psychron node"
        android:icon="@drawable/ic_node"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:usesCleartextTraffic="false"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".NodeService"
            android:exported="false"
            android:foregroundServiceType="microphone|location|dataSync" />
    </application>
</manifest>
