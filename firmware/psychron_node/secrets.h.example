#pragma once
// Copy this file to secrets.h and fill it in. secrets.h is in .gitignore.
//
// There is no password here and there is not meant to be. The broker has no
// plaintext listener and no password file: the node proves who it is with a
// client certificate, and that certificate lives in NVS rather than in this
// header. A key compiled into the image is a key anyone holding the board can
// read back over the serial port.
//
// Load the certificate after flashing, over the cable:
//     python -m psychron.provision --port COM4

#define WIFI_SSID       "your-ssid"
#define WIFI_PASSWORD   "your-wifi-password"

// The machine running `docker compose`. It must match a name or address in the
// broker certificate's subjectAltName, or the TLS handshake fails on hostname
// verification — see BROKER_IP in infra/make-certs.sh.
#define MQTT_HOST       "192.168.1.10"
#define MQTT_PORT       8883

// Must match the certificate CN, the broker ACL, and the device row in the
// database. All three are keyed on this string.
#define DEVICE_ID       "esp32-01"
